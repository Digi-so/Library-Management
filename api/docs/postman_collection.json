
{
  "info": {
    "name": "Library Management System API",
    "description": "API collection for authentication, genre management, and book management.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Patron",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Patron\",\n  \"email\": \"newpatron@example.com\",\n  \"password\": \"Library123\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const response = pm.response.json();",
                  "  pm.collectionVariables.set('token', response.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patron@example.com\",\n  \"password\": \"Library123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Genres",
      "item": [
        {
          "name": "Get All Genres",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/genres"
          }
        },
        {
          "name": "Get Genre By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/genres/1"
          }
        },
        {
          "name": "Create Genre",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Programming\"\n}"
            },
            "url": "{{baseUrl}}/genres"
          }
        },
        {
          "name": "Update Genre",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Genre\"\n}"
            },
            "url": "{{baseUrl}}/genres/5"
          }
        },
        {
          "name": "Delete Genre",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/genres/5"
          }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "Get All Books",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/books"
          }
        },
        {
          "name": "Get Book By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/books/1"
          }
        },
        {
          "name": "Search Books",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/books?search=Adventure"
          }
        },
        {
          "name": "Filter Books By Genre",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/books?genreId=2"
          }
        },
        {
          "name": "Paginate Books",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/books?page=1&limit=10"
          }
        },
        {
          "name": "Create Book (Librarian)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Sample Book\",\n  \"author\": \"Sample Author\",\n  \"isbn\": \"TEST-100\",\n  \"totalCopies\": 5,\n  \"genreId\": 2\n}"
            },
            "url": "{{baseUrl}}/books"
          }
        },
        {
          "name": "Update Book (Librarian)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"totalCopies\": 10\n}"
            },
            "url": "{{baseUrl}}/books/1"
          }
        },
        {
          "name": "Delete Book (Librarian)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/books/1"
          }
        }
      ]
    }
  ]
}
